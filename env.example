# Copy file này thành `env` (KHÔNG có dấu chấm đầu — Flutter loại trừ file ẩn)
# và điền giá trị của bạn.

# Lấy từ: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# (Tùy chọn) Đăng nhập Google — Web Client ID từ Google Cloud Console.
# Để trống thì nút "Tiếp tục với Google" tự ẩn.
# Xem hướng dẫn cấu hình trong README.md.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
